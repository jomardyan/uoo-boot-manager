    <UseWPF>true</UseWPF>
    <AssemblyName>Uoo.BootManager</AssemblyName>
    <RootNamespace>Uoo.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>uoo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="uoo.ico" />
    <Resource Include="uoo.png" />
    <ProjectReference Include="../Uoo.Core/Uoo.Core.csproj" />
    <ProjectReference Include="../Uoo.Platform/Uoo.Platform.csproj" />
  </ItemGroup>
</Project>
