<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN" "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>Uoo Boot Manager</vendor>
  <icon_name>org.uoo.BootManager</icon_name>
  <action id="org.uoo.boot-manager.modify">
    <description>Manage Ubuntu boot settings with Uoo Boot Manager</description>
    <message>Administrator authentication is required to change boot settings or manage Uoo backups.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/uoo-boot-helper</annotate>
  </action>
</policyconfig>
