<Window x:Class="Uoo.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uoo Boot Manager" Icon="uoo.ico" Width="1160" Height="760" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" ThemeMode="System"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="14"
        AutomationProperties.Name="Uoo Boot Manager">
  <Grid x:Name="MainContent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="24,16,24,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Uoo" FontSize="26" FontWeight="SemiBold" Margin="0,0,12,0" />
        <TextBlock Text="Boot Manager" Opacity="0.7" VerticalAlignment="Center" />
        <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="ModeBadge" Text="LIVE" FontSize="11" FontWeight="SemiBold" />
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="AdminButton" Click="Admin_Click" Margin="0,0,8,0" Padding="12,7" ToolTip="Load boot settings with administrator access" AutomationProperties.Name="Load with administrator access">
          <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE83D;" Margin="0,0,8,0" /><TextBlock Text="Load as administrator" /></StackPanel>
        </Button>
        <Button x:Name="RefreshButton" Click="Refresh_Click" Padding="10,7" Margin="0,0,8,0" ToolTip="Refresh · Ctrl+R" AutomationProperties.Name="Refresh boot settings">
          <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" />
        </Button>
        <Button x:Name="ModeButton" Click="Mode_Click" Padding="12,7" Content="Open demo" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Margin="24,0,24,14" Style="{StaticResource Card}" Padding="14,10">
      <DockPanel>
        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE946;" Margin="0,1,10,0" />
        <TextBlock x:Name="NoticeText" Text="Reading this PC's boot configuration…" TextWrapping="Wrap" />
      </DockPanel>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <ListBox x:Name="Navigation" Margin="12,0,8,12" BorderThickness="0" SelectionChanged="Navigation_SelectionChanged"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Boot manager navigation" />
      <ContentControl x:Name="PageHost" Grid.Column="1" Margin="18,0,24,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
    <Grid Grid.Row="3" Margin="24,10,24,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Height="3" Margin="0,0,0,7" Visibility="Collapsed" />
        <TextBlock x:Name="StatusText" Text="Ready" Opacity="0.7" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="No automatic restart" FontSize="12" Opacity="0.6" Margin="18,0,0,0" VerticalAlignment="Bottom" />
    </Grid>
  </Grid>
</Window>
